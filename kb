H2 = re.compile(r"^## +(.+?)\s*$")
H3 = re.compile(r"^### +(?:#(\d+)\s+)?(.+?)\s*$")
FIELD = re.compile(r"^- ([a-z][a-z -]*): ?(.*)$")
ROOT_DOC = re.compile(r"^(BACKLOG|ROADMAP|CHANGELOG|PRD|RELEASE|TEST-PLAN)[^/]*\.mdx?$", re.I)


