def service_path():
    return os.path.expanduser("~/Library/LaunchAgents/%s.plist" % SERVICE_LABEL)


def cmd_service(args):
    if sys.platform != "darwin":
        raise KbError("The service installer is macOS only. Elsewhere, keep `kb serve --no-open` running with your own process manager.")
    target = "gui/%d" % os.getuid()
    if args.action == "status":
        out = subprocess.run(["launchctl", "print", "%s/%s" % (target, SERVICE_LABEL)], capture_output=True, text=True)
        print("Running" if out.returncode == 0 else "Not running")
        return
    subprocess.run(["launchctl", "bootout", "%s/%s" % (target, SERVICE_LABEL)], capture_output=True)
    if args.action == "uninstall":
        with contextlib.suppress(FileNotFoundError):
            os.remove(service_path())
        print("Removed the Bento service.")
        return
    log = os.path.join(home_dir(), ".service.log")
    plist = """<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>%s</string>
  <key>ProgramArguments</key><array>
    <string>%s</string><string>%s</string><string>serve</string><string>--no-open</string><string>--port</string><string>%d</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>BENTO_HOME</key><string>%s</string>
    <key>PATH</key><string>%s</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>%s</string>
</dict></plist>
""" % (SERVICE_LABEL, sys.executable, os.path.join(HERE, "kb"), args.port, home_dir(),
       os.environ.get("PATH", "/usr/bin:/bin"), log)
    os.makedirs(os.path.dirname(service_path()), exist_ok=True)
    atomic_write(service_path(), plist)
    out = subprocess.run(["launchctl", "bootstrap", target, service_path()], capture_output=True, text=True)
    if out.returncode:
        raise KbError("launchctl couldn't start the service: %s" % out.stderr.strip())
    print("Bento now runs in the background at http://127.0.0.1:%d and starts at login." % args.port)


