def thread_links(full):
    """Links that start a new Codex or Claude Code thread on a doc. The person still presses send."""
    prompt = "Open %s and help me edit it. Read it first, then ask what I want to change. Save your edits to that file." % full
    quote = lambda value: urllib.parse.quote(value, safe="")
    home = quote(home_dir())
    claude = "claude://code/new?folder=%s&q=%s" if os.path.isdir("/Applications/Claude.app") else "claude-cli://open?cwd=%s&q=%s"
    return {
        "codex": "codex://threads/new?path=%s&prompt=%s" % (home, quote(prompt)),
        "claude": claude % (home, quote(prompt)),
    }


def read_doc(path):
    rel = resolve_doc(path).partition("#")[0]
    full = os.path.join(home_dir(), rel)
    with open(full, encoding="utf-8", errors="replace") as f:
        return {"path": rel, "text": f.read(), "links": thread_links(full)}


def api_doc_save(data):
    """Save a doc from the web board, unless it changed since it was opened."""
    rel = resolve_doc(data["path"]).partition("#")[0]
    full = os.path.join(home_dir(), rel)
    text = data["text"]
    if not isinstance(text, str):
        raise KbError("A doc's text must be text.")
    with open(os.path.join(home_dir(), ".board.lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        with open(full, encoding="utf-8", errors="replace") as f:
            if f.read() != data.get("base"):
                raise Conflict("This doc changed while you were editing it. Copy your text, then reopen the doc.")
        atomic_write(full, text)


def make_handler(port):
    allowed_hosts = {"127.0.0.1:%d" % port, "localhost:%d" % port}
    allowed_origins = {"http://" + h for h in allowed_hosts}
    actions = {
        "/api/move": api_move, "/api/add": api_add, "/api/edit": api_edit,
        "/api/review": api_review, "/api/set": api_set, "/api/delete": api_delete, "/api/doc-save": api_doc_save, "/api/milestone-doc": api_milestone_doc, "/api/archive": lambda d: archive_done(),
        "/api/answer": api_answer, "/api/send-back": api_send_back, "/api/inbox-order": api_inbox_order,
        "/api/ship": api_ship, "/api/bar": api_bar,
    }

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def send(self, status, body, content_type="application/json"):
            payload = body.encode("utf-8")
            self.send_response(status)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(payload)

        def host_ok(self):
            if self.headers.get("Host") in allowed_hosts:
                return True
            self.send(403, json.dumps({"error": "Forbidden"}))
            return False

        def stream(self):
            """Server-sent events: one message each time the board changes."""
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            seen = Hub.count
            with contextlib.suppress(OSError):
                self.wfile.write(b": connected\n\n")
                self.wfile.flush()
                while True:
                    with Hub.cond:
                        Hub.cond.wait_for(lambda: Hub.count != seen, timeout=25)
                        changed = Hub.count != seen
                        seen = Hub.count
                    self.wfile.write(b"data: change\n\n" if changed else b": alive\n\n")
                    self.wfile.flush()

        def do_GET(self):
            if not self.host_ok():
                return
            url = urllib.parse.urlsplit(self.path)
            try:
                if url.path == "/":
                    with open(os.path.join(HERE, "board.html"), encoding="utf-8") as f:
                        self.send(200, f.read(), "text/html; charset=utf-8")
                elif url.path == "/api/board":
                    with open(board_path(), encoding="utf-8") as f:
                        text = f.read()
                    data = board_json(parse(text))
                    data["version"] = hashlib.sha1(text.encode("utf-8")).hexdigest()
                    self.send(200, json.dumps(data))
                elif url.path == "/api/stream":
                    self.stream()
                elif url.path == "/api/digest":
                    self.send(200, digest(load()), "text/markdown; charset=utf-8")
                elif url.path == "/api/health":
                    self.send(200, json.dumps(health(load())))
                elif url.path == "/api/reports":
                    self.send(200, json.dumps(reports_json()))
                elif url.path == "/api/docs":
                    self.send(200, json.dumps(list_docs()))
                elif url.path == "/api/doc":
                    path = urllib.parse.parse_qs(url.query).get("path", [""])[0]
                    self.send(200, json.dumps(read_doc(path)))
                else:
                    self.send(404, json.dumps({"error": "Not found"}))
            except KbError as e:
                self.send(404, json.dumps({"error": str(e)}))
            except OSError as e:
                self.send(500, json.dumps({"error": str(e)}))

        def do_POST(self):
            if not self.host_ok():
                return
            origin = self.headers.get("Origin")
            is_json = self.headers.get("Content-Type", "").startswith("application/json")
            action = actions.get(self.path)
            if (origin and origin not in allowed_origins) or not is_json:
                self.send(403, json.dumps({"error": "Forbidden"}))
            elif not action:
                self.send(404, json.dumps({"error": "Not found"}))
            else:
                try:
                    CTX.actor = owner().lower()
                    length = int(self.headers.get("Content-Length") or 0)
                    result = action(json.loads(self.rfile.read(length) or b"{}"))
                    self.send(200, json.dumps(result if isinstance(result, dict) else {"ok": True}))
                except Conflict as e:
                    self.send(409, json.dumps({"error": str(e)}))
                except (KbError, KeyError, ValueError) as e:
                    self.send(400, json.dumps({"error": str(e)}))

    return Handler


def cmd_serve(args):
    try:
        server = http.server.ThreadingHTTPServer(("127.0.0.1", args.port), make_handler(args.port))
    except OSError as e:
        url = "http://127.0.0.1:%d" % args.port
        with contextlib.suppress(OSError, ValueError):
            with urllib.request.urlopen(url + "/api/board", timeout=2) as res:
                json.load(res)
            print("Bento is already running at %s" % url)
            if not args.no_open:
                webbrowser.open(url)
            return
        raise KbError("Can't use port %d (%s). Try --port." % (args.port, e.strerror))
    url = "http://127.0.0.1:%d" % args.port
    print("Bento at %s (Ctrl-C to stop)\nWorkspace: %s" % (url, home_dir()), flush=True)
    threading.Thread(target=watch_workspace, daemon=True).start()
    if not args.no_open:
        webbrowser.open(url)
    with contextlib.suppress(KeyboardInterrupt):
        server.serve_forever()


def board_running(url):
    with contextlib.suppress(OSError, ValueError):
        with urllib.request.urlopen(url + "/api/board", timeout=2) as res:
            json.load(res)
        return True
    return False


def cmd_open(args):
    url = "http://127.0.0.1:%d" % args.port
    if not board_running(url):
        proc = subprocess.Popen(
            [sys.executable, os.path.realpath(__file__), "serve", "--no-open", "--port", str(args.port)],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True,
        )
        deadline = time.time() + 10
        while not board_running(url):
            if proc.poll() is not None or time.time() > deadline:
                raise KbError("Couldn't start the board on port %d. Run kb serve to see why." % args.port)
            time.sleep(0.2)
        print("Started Bento in the background (pid %d). kb service install keeps it running at login." % proc.pid)
    webbrowser.open(url)
    print("Opened %s" % url)


