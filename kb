# ---- Connected projects -----------------------------------------------------


def git_env():
    """On macOS, prefer the Command Line Tools, so an unaccepted Xcode license can't break git."""
    env = dict(os.environ)
    tools = "/Library/Developer/CommandLineTools"
    if sys.platform == "darwin" and "DEVELOPER_DIR" not in env and os.path.isdir(tools):
        env["DEVELOPER_DIR"] = tools
    return env


def git(path, *args):
    try:
        out = subprocess.run(["git", "-C", path] + list(args), capture_output=True, text=True, timeout=120, env=git_env())
    except (OSError, subprocess.SubprocessError):
        return None
    return out.stdout.strip() if out.returncode == 0 else None


def normalize_remote(url):
    if not url:
        return None
    url = re.sub(r"^[a-z+]+://", "", url.strip())
    url = re.sub(r"^[^@/]+@", "", url)
    url = url.replace(":", "/")
    return re.sub(r"(\.git)?/?$", "", url).lower()


def repo_root(path):
    """The main checkout of the repo at path, even when path is a worktree."""
    common = git(path, "rev-parse", "--path-format=absolute", "--git-common-dir")
    return os.path.dirname(os.path.realpath(common)) if common else None


def detect_project(path=None):
    """Which connected project is this folder in? Git remote first, so every worktree matches."""
    path = os.path.realpath(path or os.getcwd())
    projects = read_config().get("projects", {})
    remote = normalize_remote(git(path, "remote", "get-url", "origin"))
    if remote:
        for name, info in projects.items():
            if info.get("remote") == remote:
                return name
    for name, info in projects.items():
        for root in info.get("paths", []):
            if path == root or path.startswith(root + os.sep):
                return name
    return None


def default_branch(path):
    ref = git(path, "symbolic-ref", "-q", "--short", "refs/remotes/origin/HEAD")
    if ref:
        return ref
    for candidate in ("origin/main", "origin/master", "main", "master"):
        if git(path, "rev-parse", "-q", "--verify", candidate):
            return candidate
    return None


def import_docs(name, path, fetch=True):
    """Snapshot a repo's docs from its default branch, so worktree and feature-branch copies don't matter."""
    if fetch:
        git(path, "fetch", "origin", "--quiet")
    ref = default_branch(path)
    if not ref:
        raise KbError("%s has no default branch to import docs from." % path)
    listing = git(path, "ls-tree", "-r", "--name-only", ref) or ""
    files = [
        f for f in listing.splitlines()
        if (f.startswith("docs/") and f.lower().endswith(DOC_SUFFIXES)) or ROOT_DOC.match(f)
    ]
    dest = os.path.join(home_dir(), "products", name)
    for rel in files:
        out = subprocess.run(["git", "-C", path, "show", "%s:%s" % (ref, rel)], capture_output=True, env=git_env())
        if out.returncode:
            continue
        target = os.path.join(dest, rel)
        os.makedirs(os.path.dirname(target), exist_ok=True)
        with open(target, "wb") as f:
            f.write(out.stdout)
    os.makedirs(dest, exist_ok=True)
    commit = git(path, "rev-parse", "--short", ref)
    atomic_write(
        os.path.join(dest, "SOURCE.md"),
        "# Source\n\nImported %d docs on %s from `%s` at `%s` (%s).\n" % (len(files), today(), ref, commit, path),
    )
    return len(files)


def resolve_doc(path, project=None):
    """Turn a doc reference into a workspace-relative path, keeping any #anchor. Refuses paths outside the workspace."""
    file_part, _, anchor = path.partition("#")
    home = home_dir()
    candidates = [file_part]
    if project:
        candidates += [os.path.join("products", project, file_part), os.path.join("products", project, "docs", file_part)]
    for candidate in candidates:
        full = os.path.realpath(os.path.join(home, os.path.expanduser(candidate)))
        if full.startswith(home + os.sep) and full.lower().endswith(DOC_SUFFIXES) and os.path.isfile(full):
            return os.path.relpath(full, home) + ("#" + anchor if anchor else "")
    raise KbError("No doc at '%s' in the workspace. Run: kb docs" % path)


def list_docs(project=None):
    """Connected projects and their docs, with plans first and the main planning docs next."""
    config = read_config()
    root = os.path.join(home_dir(), "products")
    names = set(config.get("projects", {}))
    if os.path.isdir(root):
        names |= {n for n in os.listdir(root) if os.path.isdir(os.path.join(root, n))}
    if project:
        names &= {project}

    def rank(rel):
        base = os.path.basename(rel).upper()
        for i, word in enumerate(("BACKLOG", "ROADMAP", "RELEASE", "TEST-PLAN")):
            if base.startswith(word):
                return (i, rel)
        return (9, rel)

    result = []
    for name in sorted(names):
        plans, docs = [], []
        for folder, _, files in os.walk(os.path.join(root, name)):
            for filename in files:
                if filename.lower().endswith(DOC_SUFFIXES) and filename != "SOURCE.md":
                    rel = os.path.relpath(os.path.join(folder, filename), home_dir())
                    (plans if os.sep + "plans" + os.sep + filename in rel and rel.split(os.sep)[2] == "plans" else docs).append(rel)
        result.append({"name": name, "plans": sorted(plans), "docs": sorted(docs, key=rank)})
    return result


# ---- Board file -------------------------------------------------------------


class Card:
    def __init__(self, id, title, lines=None):
        self.id, self.title, self.lines = id, title, lines or []

    def _field_count(self):
        count = 0
        for line in self.lines:
            if not FIELD.match(line):
                break
            count += 1
        return count

    def fields(self):
        return {m.group(1): m.group(2) for m in map(FIELD.match, self.lines[: self._field_count()])}

    def get(self, key):
        return self.fields().get(key)

    def set(self, key, value):
        count = self._field_count()
        for i in range(count):
            if FIELD.match(self.lines[i]).group(1) == key:
                if value is None:
                    del self.lines[i]
                else:
                    self.lines[i] = "- %s: %s" % (key, one_line(value))
                return
        if value is not None:
            self.lines.insert(count, "- %s: %s" % (key, one_line(value)))

    def note(self, text, who=None):
        if self.lines and self._field_count() == len(self.lines):
            self.lines.append("")
        prefix = "%s %s" % (today(), who) if who else today()
        self.lines.append("- %s: %s" % (prefix, one_line(text)))

    def numbers(self, key):
        return [int(n) for n in re.findall(r"\d+", self.get(key) or "")]

    def markdown(self):
        return "\n".join(["### #%d %s" % (self.id, self.title)] + self.lines)


class Section:
    def __init__(self, name):
        self.name, self.intro, self.cards = name, [], []


class Board:
    def __init__(self):
        self.preamble, self.sections = [], []
        self.events = []  # Extra events to log on save, beyond what diff_events sees.

    def log(self, card, type, **extra):
        self.events.append(dict(extra, type=type, id=card.id, title=card.title, project=card.get("project")))

    def column(self, name):
        name = "Scratchpad" if name.lower() == "desk" else name
        for section in self.sections:
            if section.name.lower() == name.lower():
                return section
        raise KbError("No column called '%s'. Columns: %s" % (name, ", ".join(s.name for s in self.sections)))

    def find(self, id):
        for section in self.sections:
            for card in section.cards:
                if card.id == id:
                    return section, card
        raise KbError("No card #%s on the board." % id)

    def all_cards(self):
        return [(s, c) for s in self.sections for c in s.cards]

    def next_id(self):
        highest = max([c.id or 0 for _, c in self.all_cards()] + [0])
        for path in (archive_path(), trash_path()):
            if os.path.exists(path):
                with open(path, encoding="utf-8") as f:
                    highest = max([highest] + [int(n) for n in re.findall(r"^### #(\d+)", f.read(), re.M)])
        return highest + 1

    def serialize(self):
        out = list(self.preamble)
        while out and not out[-1].strip():
            out.pop()
        out.append("")
        for section in self.sections:
            out += ["## " + section.name, ""]
            if section.intro:
                out += section.intro + [""]
            for card in section.cards:
                out += card.markdown().split("\n") + [""]
        return "\n".join(out).rstrip("\n") + "\n"


def trim(lines):
    while lines and not lines[0].strip():
        lines.pop(0)
    while lines and not lines[-1].strip():
        lines.pop()
    return lines


def parse(text):
    board = Board()
    section = card = None
    fenced = False
    for line in text.splitlines():
        if line.lstrip().startswith("```"):
            fenced = not fenced
        if not fenced:
            m = H2.match(line)
            if m:
                # "Desk" was this column's earlier name.
                section, card = Section("Scratchpad" if m.group(1).lower() == "desk" else m.group(1)), None
                board.sections.append(section)
                continue
            m = H3.match(line)
            if m and section:
                card = Card(int(m.group(1)) if m.group(1) else None, m.group(2))
                section.cards.append(card)
                continue
        if card:
            card.lines.append(line)
        elif section:
            section.intro.append(line)
        else:
            board.preamble.append(line)

    for section in board.sections:
        trim(section.intro)
        for c in section.cards:
            trim(c.lines)

    # Keep the standard columns in order; any extra columns follow them.
    known = {s.name.lower(): s for s in board.sections}
    extras = [s for s in board.sections if s.name.lower() not in {c.lower() for c in COLUMNS}]
    board.sections = [known.get(c.lower()) or Section(c) for c in COLUMNS] + extras

    # Number hand-written cards, and renumber any accidental duplicates.
    seen = set()
    for _, c in board.all_cards():
        if c.id in seen:
            c.id = None
        elif c.id is not None:
            seen.add(c.id)
    for _, c in board.all_cards():
        if c.id is None:
            c.id = board.next_id()
    return board


def load():
    try:
        with open(board_path(), encoding="utf-8") as f:
            return parse(f.read())
    except FileNotFoundError:
        raise KbError("No board at %s. Run: kb init" % board_path())


def atomic_write(path, text):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".kb-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, os.stat(path).st_mode & 0o777 if os.path.exists(path) else 0o644)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


@contextlib.contextmanager
def locked():
    """Read, change and save the board while holding an exclusive lock."""
    if not os.path.isdir(home_dir()):
        raise KbError("No workspace at %s. Run: kb init" % home_dir())
    with open(os.path.join(home_dir(), ".board.lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        board = load()
        before = snapshot(board)
        yield board
        # Log before replacing the board: watchers wake on the replace and must find the events.
        base = {"time": int(time.time()), "actor": getattr(CTX, "actor", None), "session": (current_session() or {}).get("id")}
        append_events(diff_events(before, board) + [dict(base, **e) for e in board.events])
        atomic_write(board_path(), board.serialize())


# ---- Events and notifications -----------------------------------------------


def events_path():
    return os.path.join(home_dir(), "EVENTS.log")


def snapshot(board):
    return {c.id: (s.name.lower(), c.get("blocked"), c.get("approved")) for s, c in board.all_cards()}


def diff_events(before, board):
    events = []
    for section, card in board.all_cards():
        base = {
            "time": int(time.time()), "id": card.id, "title": card.title,
            "project": card.get("project"), "actor": getattr(CTX, "actor", None),
            "session": (current_session() or {}).get("id"),
        }
        old = before.get(card.id)
        if old is None:
            events.append(dict(base, type="added", to=section.name))
            continue
        if old[0] != section.name.lower():
            events.append(dict(base, type="moved", to=section.name))
        blocked = card.get("blocked")
        if blocked and blocked != old[1]:
            events.append(dict(base, type="blocked", reason=blocked))
        elif old[1] and not blocked:
            events.append(dict(base, type="unblocked"))
        if card.get("approved") and not old[2]:
            events.append(dict(base, type="approved"))
    return events


def append_events(events):
    if events:
        with open(events_path(), "a", encoding="utf-8") as f:
            f.write("".join(json.dumps(e) + "\n" for e in events))


def describe(event):
    """Title and message if the owner should hear about this event, else None."""
    if (event.get("actor") or "") == owner().lower():
        return None
    label = "#%s %s" % (event["id"], event["title"])
    title = "Bento" + (" · " + event["project"] if event.get("project") else "")
    if event["type"] == "blocked":
        return title, "%s needs you: %s" % (label, event.get("reason", ""))
    if event["type"] == "moved" and event.get("to", "").lower() == "review":
        return title, "%s is ready for review" % label
    if event["type"] == "moved" and event.get("to", "").lower() == "done":
        return title, "%s is done" % label
    return None


def send_notifications(events):
    """Run the owner's optional notify command for anything worth their attention."""
    command = read_config().get("notify", {}).get("command")
    if not command:
        return
    for event in events:
        text = describe(event)
        if text:
            env = dict(os.environ, BENTO_TITLE=text[0], BENTO_MESSAGE=text[1])
            subprocess.run(["/bin/sh", "-c", command], input=json.dumps(event), text=True,
                           env=env, capture_output=True, timeout=60)


# ---- Waking agent sessions --------------------------------------------------


def current_session():
    """The harness session this command is running in, if any."""
    if os.environ.get("CODEX_THREAD_ID"):
        return {"harness": "codex", "id": os.environ["CODEX_THREAD_ID"]}
    if os.environ.get("CLAUDE_CODE_SESSION_ID"):
        return {"harness": "claude", "id": os.environ["CLAUDE_CODE_SESSION_ID"]}
    return None


def wake_path():
    return os.path.join(home_dir(), ".notify.wake.json")


def read_wakes():
    try:
        with open(wake_path(), encoding="utf-8") as f:
            return json.load(f)
    except (FileNotFoundError, ValueError):
        return []


def add_wake(session_id, ids, cwd):
    with open(os.path.join(home_dir(), ".notify.lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        wakes = read_wakes()
        wakes.append({"session": session_id, "ids": sorted(set(ids)), "cwd": cwd})
        atomic_write(wake_path(), json.dumps(wakes, indent=2) + "\n")


def hear_back_hint(ids):
    """Arrange for this session to hear when the epics finish, in the way its harness supports."""
    session = current_session()
    numbers = " ".join(str(i) for i in ids)
    if session and session["harness"] == "codex":
        add_wake(session["id"], ids, os.getcwd())
        print("This Codex session will be resumed when they finish or get stuck. End your turn; don't poll.")
    elif session:
        print("To hear back, run `kb wait %s` as a background command, then end your turn; don't poll." % numbers)


def label_cards(board, ids):
    labels = []
    for i in ids:
        with contextlib.suppress(KbError):
            labels.append("#%d %s" % (i, board.find(i)[1].title))
    return labels or ["#%d" % i for i in ids]


def collect_wakes(events):
    """Work out which sessions to wake. Call while holding the notify lock."""
    changes = [e for e in events if e["type"] in ("moved", "blocked")]
    wakes = read_wakes()
    if not changes or not wakes:
        return []
    board = load()
    # The log is written just before the board, so apply these events on top of what we read.
    states = {c.id: s.name.lower() for s, c in board.all_cards()}
    for event in changes:
        if event["type"] == "moved":
            states[event["id"]] = event["to"].lower()
    due, keep = [], []
    for wake in wakes:
        mine = [e for e in changes if e["id"] in wake["ids"]]
        stuck = [e for e in mine if e["type"] == "blocked" and e.get("session") != wake["session"]]
        finished = all(states.get(i, "done") in ("review", "done") for i in wake["ids"])
        if finished and mine:
            if any(e.get("session") != wake["session"] for e in mine):
                due.append((wake, "Bento update: %s finished and reached Review. Run `kb show <id>` to read the notes." % "; ".join(label_cards(board, wake["ids"]))))
            continue
        keep.append(wake)
        for event in stuck:
            due.append((wake, "Bento update: #%d %s is blocked: %s" % (event["id"], event["title"], event.get("reason", ""))))
    atomic_write(wake_path(), json.dumps(keep, indent=2) + "\n")
    return due


def wake_session(wake, message):
    """Resume a Codex session with the news, without waiting for its turn to finish."""
    prompt = message + " Tell the user what happened in this thread. Don't start new work unless your plan already says to."
    codex = shutil.which("codex")
    if not codex:
        print("kb: can't wake session %s: codex isn't on PATH" % wake["session"], file=sys.stderr)
        return
    cwd = wake["cwd"] if os.path.isdir(wake.get("cwd", "")) else home_dir()
    subprocess.Popen(
        [codex, "exec", "--skip-git-repo-check", "--color", "never", "resume", wake["session"], prompt],
        cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=sys.stderr, start_new_session=True,
    )


def deliver_pending():
    """Send anything new in the event log, exactly once, however many servers are running."""
    path = events_path()
    offset_file = os.path.join(home_dir(), ".notify.offset")
    with open(os.path.join(home_dir(), ".notify.lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        size = os.path.getsize(path) if os.path.exists(path) else 0
        if not os.path.exists(offset_file):
            atomic_write(offset_file, str(size))  # Don't replay history on first run.
            return
        with open(offset_file, encoding="utf-8") as f:
            offset = int(f.read().strip() or 0)
        if size <= offset:
            return
        with open(path, "rb") as f:
            f.seek(offset)
            data = f.read()
        data = data[: data.rfind(b"\n") + 1]
        atomic_write(offset_file, str(offset + len(data)))
        events = []
        for line in data.decode("utf-8", "replace").splitlines():
            with contextlib.suppress(ValueError):
                events.append(json.loads(line))
        due = collect_wakes(events)
    try:
        for wake, message in due:
            wake_session(wake, message)
        send_notifications(events)
    except (OSError, subprocess.SubprocessError) as e:
        print("kb: couldn't send an update: %s" % e, file=sys.stderr)


class Watch:
    """Sleep until the workspace changes. Uses kernel events where available, so nothing polls."""

    def __init__(self):
        self.kq = None
        self.last = self._stamp()
        if hasattr(select, "kqueue"):
            self.fd = os.open(home_dir(), os.O_RDONLY)
            self.kq = select.kqueue()
            self.event = select.kevent(
                self.fd, filter=select.KQ_FILTER_VNODE,
                flags=select.KQ_EV_ADD | select.KQ_EV_CLEAR, fflags=select.KQ_NOTE_WRITE,
            )
            self.kq.control([self.event], 0, 0)

    def _stamp(self):
        with contextlib.suppress(OSError):
            stat = os.stat(board_path())
            return (stat.st_mtime_ns, stat.st_size)
        return None

    def wait(self, timeout):
        if self.kq:
            self.kq.control(None, 1, timeout)
            return
        deadline = time.time() + timeout
        while time.time() < deadline and self._stamp() == self.last:
            time.sleep(1)  # No kernel events on this system (e.g. Linux without kqueue).
        self.last = self._stamp()


class Hub:
    """Tells open web boards the moment something changes."""

    cond = threading.Condition()
    count = 0

    @classmethod
    def bump(cls):
        with cls.cond:
            cls.count += 1
            cls.cond.notify_all()


def snapshot_workspace():
    """Commit workspace changes to its own local repo, so edits can be undone. This never pushes."""
    home = home_dir()
    if not os.path.isdir(os.path.join(home, ".git")) or not git(home, "status", "--porcelain"):
        return False
    git(home, "add", "-A")
    identity = ["-c", "user.name=Bento", "-c", "user.email=bento@localhost", "-c", "commit.gpgsign=false"]
    return git(home, *identity, "commit", "--no-verify", "-q", "-m", "Snapshot") is not None


def watch_workspace():
    watch = Watch()
    last = None
    last_snapshot = 0
    while True:
        with contextlib.suppress(Exception):
            if time.time() - last_snapshot >= 60:
                last_snapshot = time.time()
                snapshot_workspace()
            deliver_pending()
            stat = os.stat(board_path())
            stamp = (stat.st_mtime_ns, stat.st_size)
            if stamp != last:
                last = stamp
                Hub.bump()
        watch.wait(30)


# ---- Picking work -----------------------------------------------------------


def why_not_ready(board, card, who=None):
    """Return why this card can't be picked up by `who`, or None if it can."""
    if card.get("kind") == "milestone":
        return "a milestone, not work to pick up"
    if card.get("blocked"):
        return "blocked: " + card.get("blocked")
    column_of = {c.id: s.name.lower() for s, c in board.all_cards()}
    waiting = [n for n in card.numbers("needs") if column_of.get(n, "done") != "done"]
    if waiting:
        return "waiting on " + ", ".join("#%d" % n for n in waiting)
    building = [n for n in card.numbers("verifies") if column_of.get(n, "done") not in ("review", "done")]
    if building:
        return "nothing to test until " + ", ".join("#%d" % n for n in building) + " reaches Review"
    target = (card.get("for") or "any").lower()
    if who and target not in ("any", who.lower()):
        return "for " + target
    return None


def pick(board, who=None, project=None):
    for card in board.column("Next").cards:
        if project and card.get("project") != project:
            continue
        if not why_not_ready(board, card, who):
            return card
    return None


def held_by(board, who):
    return [
        c for c in board.column("Doing").cards
        if (c.get("claimed") or "").split(" ")[0].lower() == who.lower() and not c.get("blocked")
    ]


def move_card(board, card, column, before=None, top=False):
    source, _ = board.find(card.id)
    dest = board.column(column)
    source.cards.remove(card)
    if source.name.lower() == "scratchpad" and dest.name.lower() not in ("scratchpad", "done"):
        # Promoted from a scratchpad note to an epic anyone can pick up.
        card.set("kind", None)
        card.set("for", "any")
    if dest.name.lower() in ("scratchpad", "backlog", "next"):
        card.set("claimed", None)
    index = len(dest.cards)
    if top or (before is None and dest.name.lower() == "done"):
        index = 0
    elif before is not None:
        for i, other in enumerate(dest.cards):
            if other.id == before:
                index = i
                break
    dest.cards.insert(index, card)


def read_trash():
    trash = Board()
    if os.path.exists(trash_path()):
        with open(trash_path(), encoding="utf-8") as f:
            trash = parse(f.read())
    else:
        trash = parse("# Trash\n\nDeleted cards. Bring one back with: kb restore <id>\n")
    return trash


def delete_card(id):
    """Move a card to TRASH.md and clear every reference to it."""
    with locked() as board:
        section, card = board.find(id)
        trash = read_trash()
        trash.column(section.name).cards.insert(0, card)
        atomic_write(trash_path(), trash.serialize())
        section.cards.remove(card)
        for _, other in board.all_cards():
            for field in ("needs", "verifies"):
                if id in other.numbers(field):
                    rest = [n for n in other.numbers(field) if n != id]
                    other.set(field, ", ".join("#%d" % n for n in rest) or None)
        title = card.title
    with open(os.path.join(home_dir(), ".notify.lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        wakes = read_wakes()
        if wakes:
            for wake in wakes:
                wake["ids"] = [i for i in wake["ids"] if i != id]
            atomic_write(wake_path(), json.dumps([w for w in wakes if w["ids"]], indent=2) + "\n")
    return title


def restore_card(id):
    with locked() as board:
        trash = read_trash()
        section, card = trash.find(id)
        section.cards.remove(card)
        board.column(section.name).cards.insert(0, card)
        atomic_write(trash_path(), trash.serialize())
    return card.title, section.name


def archive_done():
    with locked() as board:
        done = board.column("Done")
        cards, done.cards = done.cards, []
        if cards:
            existing = "# Archive\n"
            if os.path.exists(archive_path()):
                with open(archive_path(), encoding="utf-8") as f:
                    existing = f.read()
            block = "\n\n".join(c.markdown() for c in cards)
            atomic_write(archive_path(), existing.rstrip("\n") + "\n\n" + block + "\n")
    return len(cards)


def dependency_ids(board, card):
    """Everything this card waits on, directly or through other cards, nearest first."""
    seen, queue = [], card.numbers("needs") + card.numbers("verifies")
    while queue:
        current = queue.pop(0)
        if current in seen or current == card.id:
            continue
        seen.append(current)
        with contextlib.suppress(KbError):
            other = board.find(current)[1]
            queue += other.numbers("needs") + other.numbers("verifies")
    return seen


def check_dated(card_kind):
    if card_kind not in DATED_KINDS:
        raise KbError("Dates belong on milestones and releases. Link this epic to one with needs instead.")


def valid_date(value):
    try:
        datetime.date.fromisoformat(value)
    except (TypeError, ValueError):
        raise KbError("Dates look like 2026-12-01.")
    return value


def tracking(board, section, card):
    """Where a dated or release epic stands, with its dependencies."""
    deps = []
    for dep_id in dependency_ids(board, card):
        with contextlib.suppress(KbError):  # Not on the board means archived, so finished.
            dep_section, dep = board.find(dep_id)
            deps.append({
                "id": dep.id, "title": dep.title, "column": dep_section.name,
                "blocked": dep.get("blocked"), "target": dep.get("target"),
            })
    open_deps = [d for d in deps if d["column"].lower() != "done"]
    target = card.get("target")
    status, reason = "on track", None
    try:
        days = (datetime.date.fromisoformat(target) - datetime.date.today()).days if target else None
    except ValueError:
        days, target = None, None
    if section.name.lower() == "done":
        status = "reached"
    elif not target:
        status = "no date"
    elif days < 0:
        status, reason = "late", "The date has passed."
    else:
        blocked = [d for d in open_deps if d["blocked"]]
        later = [d for d in open_deps if d["target"] and d["target"] > target]
        if card.get("blocked") or blocked:
            status, reason = "at risk", "#%d is blocked." % (blocked[0]["id"] if blocked else card.id)
        elif later:
            status, reason = "at risk", "#%d is dated after this." % later[0]["id"]
        elif open_deps and days <= 7:
            status, reason = "at risk", "%d %s open with %d %s left." % (len(open_deps), "dependency is" if len(open_deps) == 1 else "dependencies are", days, "day" if days == 1 else "days")
    return {
        "id": card.id, "target": target, "status": status, "reason": reason, "deps": deps,
        "done": len(deps) - len(open_deps), "total": len(deps),
    }


def card_json(board, section, card):
    return {
        "id": card.id,
        "title": card.title,
        "column": section.name,
        "fields": card.fields(),
        "body": "\n".join(card.lines),
        "not_ready": why_not_ready(board, card),
        "decisions": [decision_json(d) for d in decisions_for(card.id)],
    }


def board_json(board):
    top = pick(board)
    config = read_config()
    used = {c.get("project") for _, c in board.all_cards() if c.get("project")}
    return {
        "columns": [
            {"name": s.name, "cards": [card_json(board, s, c) for c in s.cards]}
            for s in board.sections
        ],
        "up_next": top.id if top else None,
        "today": today(),
        "tracking": [
            tracking(board, s, c) for s, c in board.all_cards()
            if s.name.lower() != "scratchpad" and c.get("kind") in DATED_KINDS
        ],
        "owner": config.get("owner", "me"),
        "projects": sorted(used | set(config.get("projects", {}))),
        "kinds": KINDS,
        "inbox": inbox(board, config),
        "inbox_order": inbox_order(config),
        "inbox_sections": [[k, v] for k, v in INBOX_SECTIONS.items()],
    }


# ---- Inbox ------------------------------------------------------------------

INBOX_SECTIONS = {
    "blocked": "Blocked until you answer",
    "plans": "Plans to approve",
    "review": "Finished work to accept",
    "changed": "Done-whens an agent changed",
    "done-when": "Next cards missing a done-when",
    "quiet": "Work that's gone quiet",
    "yours": "Epics assigned to you",
    "milestones": "Milestones past their date",
    "scratchpad": "Scratchpad notes to promote",
}
DEFAULT_INBOX = list(INBOX_SECTIONS)
# The sections that existed before the inbox remembered which ones you had seen.
LEGACY_INBOX = ["blocked", "plans", "review", "done-when", "yours", "milestones", "scratchpad"]


def inbox_order(config=None):
    """The saved order. Sections added since it was saved join in their default place."""
    config = config if config is not None else read_config()
    order = config.get("inbox")
    if not isinstance(order, list):
        return list(DEFAULT_INBOX)
    seen = config.get("inbox_seen") or LEGACY_INBOX
    order = [k for k in order if k in INBOX_SECTIONS]
    for i, key in enumerate(DEFAULT_INBOX):
        if key not in seen and key not in order:
            before = [k for k in DEFAULT_INBOX[:i] if k in order]
            order.insert(order.index(before[-1]) + 1 if before else 0, key)
    return order


def save_inbox_order(config, order):
    config["inbox"] = order
    config["inbox_seen"] = list(INBOX_SECTIONS)
    write_config(config)


def parse_inbox_order(keys):
    keys = [k.strip().lower() for k in keys if k and k.strip()]
    unknown = [k for k in keys if k not in INBOX_SECTIONS]
    if unknown:
        raise KbError("Unknown inbox section: %s. Choose from %s." % (", ".join(unknown), ", ".join(INBOX_SECTIONS)))
    return list(dict.fromkeys(keys))


def inbox_sections_for(section, card, me):
    """Every inbox section this card could sit in. The configured order decides which one wins."""
    column = section.name.lower()
    if column == "scratchpad":
        return ["scratchpad"]
    if column == "done":
        return []
    if card.get("kind") in DATED_KINDS and (card.get("target") or "9999") < today():
        return ["milestones"]
    if column == "milestones" or card.get("kind") == "milestone":
        return []
    blocked = card.get("blocked") or ""
    hits = []
    if blocked and not blocked.startswith("changes requested"):
        hits.append("blocked")
    if card.get("plan") and not card.get("approved") and not blocked and column != "review":
        hits.append("plans")
    if column == "review":
        hits.append("review")
    if card.get("done when changed"):
        hits.append("changed")
    if column == "next" and not card.get("done when"):
        hits.append("done-when")
    if column == "doing" and not blocked and quiet_since(card):
        hits.append("quiet")
    if (card.get("for") or "").lower() == me and column != "review":
        hits.append("yours")
    return hits


def card_links(card):
    """Where to check a card's work: its link field first, then web addresses in its notes."""
    found = []
    link = (card.get("link") or "").strip()
    if link:
        found.append(link)
    found += [u.rstrip(".,;:") for u in re.findall(r"https?://[^\s<>)\]\"']+", "\n".join(card.lines))]
    return list(dict.fromkeys(found))[:4]


def inbox(board, config=None, project=None):
    """What's waiting on the owner, one entry per card (or per plan), in the configured order."""
    config = config if config is not None else read_config()
    order = inbox_order(config)
    me = config.get("owner", "me").lower()
    groups = {k: [] for k in order}
    plans = {}
    for section, card in board.all_cards():
        if project and card.get("project") != project and not (section.name.lower() == "scratchpad" and not card.get("project")):
            continue
        hits = [k for k in order if k in inbox_sections_for(section, card, me)]
        if not hits:
            continue
        kind = hits[0]
        reason = {
            "blocked": card.get("blocked"),
            "plans": card.get("plan"),
            "review": card.get("claimed") and "from %s" % card.get("claimed").split(" ")[0],
            "done-when": "No done-when yet",
            "milestones": "Was due %s" % card.get("target"),
            "changed": "%s changed it. Was: %s" % (
                (card.get("done when changed") or "").split(" ")[0], card.get("done when was") or "(none)"),
            "quiet": "No update from %s since %s" % ((card.get("claimed") or "?").split(" ")[0], quiet_since(card)),
        }.get(kind)
        item = {
            "section": kind, "id": card.id, "ids": [card.id], "title": card.title, "column": section.name,
            "project": card.get("project"), "why": reason or "", "plan": card.get("plan"),
            "source": card.get("source"), "links": card_links(card),
            "options": card_options(card) if kind == "blocked" else [],
            "done_when": card.get("done when"),
        }
        if kind == "plans":
            if item["plan"] in plans:
                plans[item["plan"]]["ids"].append(card.id)
                continue
            plans[item["plan"]] = item
        groups[kind].append(item)
    return [item for k in order for item in groups[k]]


# ---- Notes, options and quiet work -------------------------------------------

NOTE = re.compile(r"^- (\d{4}-\d{2}-\d{2})(?: ([^:]+?))?: (.*)$")


def card_notes(card):
    """Dated notes on a card, oldest first: (date, author or None, text)."""
    return [m.groups() for m in map(NOTE.match, card.lines[card._field_count():]) if m]


def last_update(card):
    dates = [d for d, _, _ in card_notes(card)]
    claimed = re.search(r"\d{4}-\d{2}-\d{2}", card.get("claimed") or "")
    if claimed:
        dates.append(claimed.group(0))
    return max(dates) if dates else None


def health_setting(key, default):
    value = read_config().get("health", {}).get(key, default)
    return value if isinstance(value, int) and value > 0 else default


def days_ago(date):
    return (datetime.date.today() - datetime.date.fromisoformat(date)).days


def quiet_since(card):
    """The date of the last update on a claimed card, if it has been quiet too long."""
    last = last_update(card)
    if last and card.get("claimed") and days_ago(last) >= health_setting("quiet_days", 2):
        return last
    return None


def card_options(card):
    return [o.strip() for o in (card.get("options") or "").split("|") if o.strip()]


# ---- Decisions -------------------------------------------------------------

DECISION = re.compile(r"^### (D\d+) (.+?)\s*$")
_decisions_cache = {}


def decisions_path():
    return os.path.join(home_dir(), "DECISIONS.md")


def read_decisions():
    """Every recorded decision, oldest first."""
    path = decisions_path()
    try:
        stamp = os.stat(path).st_mtime_ns
    except FileNotFoundError:
        return []
    if _decisions_cache.get("stamp") == (path, stamp):
        return _decisions_cache["items"]
    items, current = [], None
    with open(path, encoding="utf-8") as f:
        for line in f.read().splitlines():
            m = DECISION.match(line)
            if m:
                current = {"id": m.group(1), "text": m.group(2), "fields": {}}
                items.append(current)
                continue
            field = FIELD.match(line)
            if current and field:
                current["fields"][field.group(1)] = field.group(2)
    _decisions_cache.update(stamp=(path, stamp), items=items)
    return items


def write_decisions(items):
    lines = ["# Decisions", "", "What the owner decided, oldest first. `kb why <id>` lists the ones behind an epic.", ""]
    for d in items:
        lines.append("### %s %s" % (d["id"], d["text"]))
        for key in ("date", "by", "question", "card", "implies", "supersedes", "superseded by"):
            if d["fields"].get(key):
                lines.append("- %s: %s" % (key, d["fields"][key]))
        lines.append("")
    atomic_write(decisions_path(), "\n".join(lines))


def decision_cards(d):
    """Cards a decision touches: the one it answered, then the ones it implies."""
    return [int(n) for n in re.findall(r"\d+", d["fields"].get("card", "") + " " + d["fields"].get("implies", ""))]


def decisions_for(id):
    return [d for d in reversed(read_decisions()) if id in decision_cards(d)]


def decision_json(d):
    f = d["fields"]
    return {
        "id": d["id"], "text": d["text"], "date": f.get("date"), "by": f.get("by"), "question": f.get("question"),
        "card": int(f["card"].lstrip("#")) if f.get("card") else None, "implies": [int(n) for n in re.findall(r"\d+", f.get("implies", ""))],
        "supersedes": f.get("supersedes"), "superseded_by": f.get("superseded by"),
    }


def parse_ids(text):
    return [int(n) for n in re.findall(r"\d+", text or "")]


def record_decision(board, text, who, card=None, question=None, implies=(), supersedes=None):
    """Save a decision, tell every card it touches, and retire the one it replaces. Call inside locked()."""
    text = one_line(text)
    if not text:
        raise KbError("A decision needs words.")
    items = list(read_decisions())
    implies = [n for n in dict.fromkeys(implies) if n != (card.id if card else None)]
    targets = [board.find(n)[1] for n in implies]
    old = None
    if supersedes:
        supersedes = supersedes.upper()
        old = next((d for d in items if d["id"] == supersedes), None)
        if not old:
            raise KbError("No decision %s. Run: kb why" % supersedes)
        if old["fields"].get("superseded by"):
            raise KbError("%s was already replaced by %s." % (supersedes, old["fields"]["superseded by"]))
    new_id = "D%d" % (max([int(d["id"][1:]) for d in items] + [0]) + 1)
    fields = {"date": today(), "by": who}
    if question:
        fields["question"] = one_line(question)
    if card:
        fields["card"] = "#%d" % card.id
    if implies:
        fields["implies"] = ", ".join("#%d" % n for n in implies)
    if old:
        fields["supersedes"] = old["id"]
        old["fields"]["superseded by"] = new_id
    items.append({"id": new_id, "text": text, "fields": fields})
    for other in targets:
        other.note("%s applies here%s: %s" % (new_id, " (from #%d)" % card.id if card else "", text), who)
        board.log(other, "decided", decision=new_id)
    if old:
        for n in decision_cards(old):
            with contextlib.suppress(KbError):
                touched = board.find(n)[1]
                if touched not in targets and touched is not card:
                    touched.note("%s replaced %s: %s" % (new_id, old["id"], text), who)
    if card:
        board.log(card, "decided", decision=new_id)
    write_decisions(items)
    return new_id


def answer_card(board, card, text, who, implies=(), supersedes=None):
    """Answer a blocked card. A real answer becomes a decision; #numbers in it count as cards it affects."""
    if not card.get("blocked"):
        raise KbError("#%d isn't blocked." % card.id)
    text = one_line(text or "")
    question = card.get("blocked")
    decision = None
    if text:
        implies = list(implies) + [n for n in parse_ids(" ".join(re.findall(r"#\d+", text)))]
        decision = record_decision(board, text, who, card, question, implies, supersedes)
        card.note("answered (%s): %s" % (decision, text), who)
    else:
        card.note("unblocked", who)
    card.set("blocked", None)
    card.set("options", None)
    return decision


# ---- Changing the bar ------------------------------------------------------


def ever_claimed(section, card):
    return bool(card.get("claimed")) or section.name.lower() in ("doing", "review", "done")


def change_done_when(board, section, card, value, who, reason=None, require_reason=True):
    """Change a card's done-when. Once work is claimed, that takes a reason and the owner sees it."""
    old = card.get("done when")
    if (value or None) == (old or None):
        return
    if old and ever_claimed(section, card):
        if require_reason and not (reason or "").strip():
            raise KbError("#%d has been claimed, so changing its done-when needs --reason \"what the old one got wrong\"." % card.id)
        card.note("changed the done-when%s. Was: %s" % (": " + one_line(reason) if reason else "", old), who)
        if (who or "").lower() != owner().lower():
            if not card.get("done when changed"):
                card.set("done when was", old)
            card.set("done when changed", "%s %s" % (who or "someone", today()))
        board.log(card, "bar changed", reason=reason)
    card.set("done when", value or None)


def settle_bar(card, keep, who):
    if not card.get("done when changed"):
        raise KbError("#%d's done-when hasn't been changed by an agent." % card.id)
    if keep:
        card.note("kept the new done-when", who)
    else:
        card.note("put the done-when back. Undid: %s" % card.get("done when"), who)
        card.set("done when", card.get("done when was"))
    card.set("done when was", None)
    card.set("done when changed", None)


# ---- Sending work back -----------------------------------------------------

SEND_BACK = {
    "mismatch": "doesn't match the done-when",
    "broken": "doesn't work",
    "unclear": "can't tell if it works",
    "missing": "something's missing",
    "other": "other",
}


def send_back(board, section, card, comment, reason, who):
    comment = one_line(comment or "")
    reason = (reason or "other").lower()
    if reason not in SEND_BACK:
        raise KbError("Reason must be one of: %s." % ", ".join(SEND_BACK))
    if not comment:
        raise KbError("Say what should change.")
    if section.name.lower() != "review":
        raise KbError("#%d isn't in Review." % card.id)
    move_card(board, card, "Doing")
    card.note("sent back (%s): %s" % (SEND_BACK[reason], comment), who)
    board.log(card, "sent back", reason=reason)


# ---- Shipping milestones ---------------------------------------------------


def following_milestone(board, card):
    """The next dated milestone or release in the same project, by date."""
    later = [
        c for s, c in board.all_cards()
        if c is not card and c.get("kind") in DATED_KINDS and s.name.lower() != "done"
        and c.get("project") == card.get("project") and (c.get("target") or "9999") >= (card.get("target") or "")
    ]
    return min(later, key=lambda c: (c.get("target") or "9999", c.id)) if later else None


def ship(board, id, who, next_id=None, keep=False):
    """Mark a milestone reached. Epics it needed that aren't finished move to the next milestone."""
    section, card = board.find(id)
    if card.get("kind") not in DATED_KINDS:
        raise KbError("#%d isn't a milestone or release." % id)
    if section.name.lower() == "done":
        raise KbError("#%d already shipped." % id)
    column_of = {c.id: s.name.lower() for s, c in board.all_cards()}
    unfinished = [n for n in card.numbers("needs") if column_of.get(n, "done") not in ("done", "review")]
    nxt = None
    if unfinished and not keep:
        nxt = board.find(next_id)[1] if next_id else following_milestone(board, card)
        if not nxt:
            raise KbError("%s %s not finished. Say where %s: --next <milestone>, or --keep to ship without moving them." % (
                ", ".join("#%d" % n for n in unfinished), "is" if len(unfinished) == 1 else "are",
                "it goes" if len(unfinished) == 1 else "they go"))
        if nxt.get("kind") not in DATED_KINDS or nxt is card:
            raise KbError("#%d isn't another milestone or release." % nxt.id)
        card.set("needs", ", ".join("#%d" % n for n in card.numbers("needs") if n not in unfinished) or None)
        nxt.set("needs", ", ".join("#%d" % n for n in dict.fromkeys(nxt.numbers("needs") + unfinished)))
        for n in unfinished:
            board.find(n)[1].note("moved from #%d to #%d when #%d shipped" % (card.id, nxt.id, card.id), who)
        nxt.note("took %s from #%d" % (", ".join("#%d" % n for n in unfinished), card.id), who)
    moved = " Moved %s to #%d %s." % (", ".join("#%d" % n for n in unfinished), nxt.id, nxt.title) if nxt else ""
    kept = " Shipped without %s." % ", ".join("#%d" % n for n in unfinished) if unfinished and keep else ""
    card.note("shipped." + moved + kept, who)
    move_card(board, card, "Done")
    return "#%d %s shipped.%s%s" % (card.id, card.title, moved, kept)


# ---- Health ----------------------------------------------------------------


def read_events():
    events = []
    with contextlib.suppress(FileNotFoundError):
        with open(events_path(), encoding="utf-8") as f:
            for line in f:
                with contextlib.suppress(ValueError):
                    events.append(json.loads(line))
    return events


def event_date(events, id, match):
    """The date of the latest event for this card that matches."""
    found = [e["time"] for e in events if e.get("id") == id and match(e)]
    return datetime.date.fromtimestamp(max(found)).isoformat() if found else None


def report_cadence(schedule):
    text = (schedule or "").lower()
    if "week" in text:
        return 7
    if "daily" in text or "day" in text or "weekday" in text:
        return 1
    return None


def health(board, project=None, events=None):
    """Everything stuck: what, since when, the next step and who takes it."""
    events = read_events() if events is None else events
    me = owner()
    review_days = health_setting("review_days", 2)
    rows = []

    def add(card, problem, since, step, who):
        rows.append({"id": card.id if card else None, "title": card.title if card else None,
                     "project": card.get("project") if card else None,
                     "problem": problem, "since": since, "next": step, "who": who})

    for section, card in board.all_cards():
        column = section.name.lower()
        if column in ("scratchpad", "done") or (project and card.get("project") != project):
            continue
        holder = (card.get("claimed") or "").split(" ")[0] or None
        blocked = card.get("blocked")
        if blocked:
            since = event_date(events, card.id, lambda e: e.get("type") == "blocked") or last_update(card)
            if blocked.startswith("changes requested"):
                add(card, "Plan sent back: " + blocked, since, "Update the plan, then ask for approval again", holder or card.get("for") or "any")
            else:
                add(card, "Blocked: " + blocked, since, "Answer it in the Inbox (kb answer %d \"...\")" % card.id, me)
            continue
        if column == "doing" and quiet_since(card):
            add(card, "No update since %s" % quiet_since(card), quiet_since(card),
                "Post a note on what's happening, or release it (kb move %d next)" % card.id, holder or "any")
        if column == "review":
            since = event_date(events, card.id, lambda e: e.get("type") == "moved" and e.get("to", "").lower() == "review") or last_update(card)
            if since and days_ago(since) >= review_days:
                add(card, "Waiting in Review", since, "Accept it or send it back", me)
        if card.get("done when changed"):
            add(card, "Done-when changed by %s" % card.get("done when changed"), card.get("done when changed").split(" ")[-1],
                "Keep the new done-when or put the old one back", me)
        if card.get("kind") in DATED_KINDS:
            row = tracking(board, section, card)
            if row["status"] in ("late", "at risk"):
                add(card, "%s: %s" % (row["status"].capitalize(), row["reason"]), card.get("target"),
                    "Ship it (kb ship %d), move the date, or clear what's blocking it" % card.id, me)
    for item in reports_json():
        if project and item.get("project") != project:
            continue
        cadence = report_cadence(item.get("schedule"))
        if not cadence:
            continue
        latest = (item.get("latest") or {}).get("date")
        if not latest or days_ago(latest) * 2 >= cadence * 3:  # Silent for 1.5 cadences.
            rows.append({"id": None, "title": "Report: %s" % item.get("name", item["key"]), "project": item.get("project"),
                         "problem": "No copy posted since %s" % latest if latest else "No copy posted yet",
                         "since": latest, "next": "Check the job that posts it (%s)" % (item.get("schedule") or "no schedule"),
                         "who": "its report job"})
    return rows


# ---- Digest ----------------------------------------------------------------

SECRETS = [
    (re.compile(r"(?i)\b(api[_-]?key|token|secret|password|passwd)\b(\s*[:=]\s*)\S+"), r"\1\2[redacted]"),
    (re.compile(r"\b(sk|pk|rk)-[A-Za-z0-9_-]{16,}"), "[redacted]"),
    (re.compile(r"\b(ghp|gho|ghs|ghu)_[A-Za-z0-9]{20,}|\bgithub_pat_[A-Za-z0-9_]{20,}"), "[redacted]"),
    (re.compile(r"\bxox[abprs]-[A-Za-z0-9-]{10,}"), "[redacted]"),
    (re.compile(r"\bAKIA[0-9A-Z]{16}\b"), "[redacted]"),
    (re.compile(r"\b[A-Za-z0-9_-]{40,}\b"), "[redacted]"),
]


def redact(text):
    for pattern, replacement in SECRETS:
        text = pattern.sub(replacement, text)
    return text


def digest(board, project=None):
    """A short Markdown briefing of the board, for you or a chat assistant. Secrets are taken out."""
    config = read_config()
    me = config.get("owner", "me")
    events = read_events()
    keep = lambda c: not project or c.get("project") == project
    tag = lambda c: " [%s]" % c.get("project") if c.get("project") and not project else ""
    out = ["# Bento briefing%s, %s" % (" for " + project if project else "", today()), ""]

    items = inbox(board, config, project)
    out.append("## Waiting on %s (%d)" % (me, len(items)))
    for key in inbox_order(config):
        group = [i for i in items if i["section"] == key]
        if group:
            out.append("")
            out.append("%s:" % INBOX_SECTIONS[key])
            for i in group:
                line = "- %s %s" % (" ".join("#%d" % n for n in i["ids"]), i["title"])
                line += " [%s]" % i["project"] if i["project"] and not project else ""
                if i["why"]:
                    line += ": " + i["why"]
                if i["options"]:
                    line += " (options: %s)" % "; ".join(i["options"])
                out.append(line)
    if not items:
        out.append("Nothing.")

    def column(name, heading, limit=None):
        cards = [c for c in board.column(name).cards if keep(c)]
        out.extend(["", "## %s (%d)" % (heading, len(cards))])
        for c in cards[:limit]:
            bits = []
            if c.get("claimed"):
                bits.append(c.get("claimed"))
            if c.get("blocked"):
                bits.append("blocked")
            out.append("- #%d %s%s%s" % (c.id, c.title, tag(c), " (%s)" % ", ".join(bits) if bits else ""))
            if name == "Next" and c.get("done when"):
                out.append("  Done when: %s" % c.get("done when"))
        if limit and len(cards) > limit:
            out.append("- and %d more" % (len(cards) - limit))
        if not cards:
            out.append("Nothing.")

    column("Doing", "In progress")
    column("Next", "Up next", 5)
    rows = [r for r in tracking_rows(board, project) if r["status"] != "reached"]
    if rows:
        out.extend(["", "## Milestones"])
        for r in rows:
            out.append("- %s #%d %s%s: %s, %d of %d done%s" % (
                r["target"] or "no date", r["id"], r["title"], " [%s]" % r["project"] if r["project"] and not project else "",
                r["status"], r["done"], r["total"], ". " + r["reason"] if r["reason"] else ""))
    stuck = health(board, project, events)
    if stuck:
        out.extend(["", "## Stuck"])
        for r in stuck:
            label = "#%d %s" % (r["id"], r["title"]) if r["id"] else r["title"]
            out.append("- %s: %s. Next: %s (%s)" % (label, r["problem"], r["next"], r["who"]))
    on_board = {c.id for _, c in board.all_cards() if keep(c)}
    recent = [d for d in reversed(read_decisions()) if d["fields"].get("date", "") >= (datetime.date.today() - datetime.timedelta(days=14)).isoformat()
              and (not project or set(decision_cards(d)) & on_board)]
    if recent:
        out.extend(["", "## Recent decisions"])
        for d in recent[:8]:
            cards = ", ".join("#%d" % n for n in decision_cards(d))
            gone = " (replaced by %s)" % d["fields"]["superseded by"] if d["fields"].get("superseded by") else ""
            out.append("- %s %s: %s%s%s" % (d["id"], d["fields"].get("date", ""), d["text"], " (%s)" % cards if cards else "", gone))
    cutoff = time.time() - 30 * 86400
    sent = [e for e in events if e.get("type") == "sent back" and e.get("time", 0) >= cutoff
            and (not project or e.get("project") == project)]
    if sent:
        counts = {}
        for e in sent:
            label = SEND_BACK.get(e.get("reason"), "other")
            counts[label] = counts.get(label, 0) + 1
        out.extend(["", "## Sent back in the last 30 days", ", ".join("%s: %d" % kv for kv in sorted(counts.items(), key=lambda kv: -kv[1]))])
    return redact("\n".join(out)) + "\n"


