def api_doc_save(data):
    """Save a doc from the web board, unless it changed since it was opened."""
    rel = resolve_doc(data["path"]).partition("#")[0]
    full = os.path.join(home_dir(), rel)
    text = data["text"]
    if not isinstance(text, str):
        raise KbError("A doc's text must be text.")
    with open(os.path.join(home_dir(), ".board.lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        with open(full, encoding="utf-8", errors="replace") as f:
            if f.read() != data.get("base"):
                raise Conflict("This doc changed while you were editing it. Copy your text, then reopen the doc.")
        atomic_write(full, text)


def make_handler(port):
    allowed_hosts = {"127.0.0.1:%d" % port, "localhost:%d" % port}
    allowed_origins = {"http://" + h for h in allowed_hosts}
    actions = {
        "/api/move": api_move, "/api/add": api_add, "/api/edit": api_edit,
        "/api/review": api_review, "/api/set": api_set, "/api/delete": api_delete, "/api/doc-save": api_doc_save, "/api/milestone-doc": api_milestone_doc, "/api/archive": lambda d: archive_done(),
        "/api/answer": api_answer, "/api/send-back": api_send_back, "/api/inbox-order": api_inbox_order,
    }

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def send(self, status, body, content_type="application/json"):
            payload = body.encode("utf-8")
            self.send_response(status)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(payload)

        def host_ok(self):
            if self.headers.get("Host") in allowed_hosts:
                return True
            self.send(403, json.dumps({"error": "Forbidden"}))
            return False

        def stream(self):
            """Server-sent events: one message each time the board changes."""
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            seen = Hub.count
            with contextlib.suppress(OSError):
                self.wfile.write(b": connected\n\n")
                self.wfile.flush()
                while True:
                    with Hub.cond:
                        Hub.cond.wait_for(lambda: Hub.count != seen, timeout=25)
                        changed = Hub.count != seen
                        seen = Hub.count
                    self.wfile.write(b"data: change\n\n" if changed else b": alive\n\n")
                    self.wfile.flush()

        def do_GET(self):
            if not self.host_ok():
                return
            url = urllib.parse.urlsplit(self.path)
            try:
                if url.path == "/":
                    with open(os.path.join(HERE, "board.html"), encoding="utf-8") as f:
                        self.send(200, f.read(), "text/html; charset=utf-8")
                elif url.path == "/api/board":
                    with open(board_path(), encoding="utf-8") as f:
                        text = f.read()
                    data = board_json(parse(text))
                    data["version"] = hashlib.sha1(text.encode("utf-8")).hexdigest()
                    self.send(200, json.dumps(data))
                elif url.path == "/api/stream":
                    self.stream()
                elif url.path == "/api/reports":
                    self.send(200, json.dumps(reports_json()))
                elif url.path == "/api/docs":
                    self.send(200, json.dumps(list_docs()))
                elif url.path == "/api/doc":
                    path = urllib.parse.parse_qs(url.query).get("path", [""])[0]
                    self.send(200, json.dumps(read_doc(path)))
                else:
                    self.send(404, json.dumps({"error": "Not found"}))
            except KbError as e:
                self.send(404, json.dumps({"error": str(e)}))
            except OSError as e:
                self.send(500, json.dumps({"error": str(e)}))

        def do_POST(self):
            if not self.host_ok():
                return
            origin = self.headers.get("Origin")
            is_json = self.headers.get("Content-Type", "").startswith("application/json")
            action = actions.get(self.path)
            if (origin and origin not in allowed_origins) or not is_json:
                self.send(403, json.dumps({"error": "Forbidden"}))
            elif not action:
                self.send(404, json.dumps({"error": "Not found"}))
            else:
                try:
                    CTX.actor = owner().lower()
                    length = int(self.headers.get("Content-Length") or 0)
                    result = action(json.loads(self.rfile.read(length) or b"{}"))
                    self.send(200, json.dumps(result if isinstance(result, dict) else {"ok": True}))
                except Conflict as e:
                    self.send(409, json.dumps({"error": str(e)}))
                except (KbError, KeyError, ValueError) as e:
                    self.send(400, json.dumps({"error": str(e)}))

    return Handler


def cmd_serve(args):
    try:
        server = http.server.ThreadingHTTPServer(("127.0.0.1", args.port), make_handler(args.port))
    except OSError as e:
        url = "http://127.0.0.1:%d" % args.port
        with contextlib.suppress(OSError, ValueError):
            with urllib.request.urlopen(url + "/api/board", timeout=2) as res:
                json.load(res)
            print("Bento is already running at %s" % url)
            if not args.no_open:
                webbrowser.open(url)
            return
        raise KbError("Can't use port %d (%s). Try --port." % (args.port, e.strerror))
    url = "http://127.0.0.1:%d" % args.port
    print("Bento at %s (Ctrl-C to stop)\nWorkspace: %s" % (url, home_dir()), flush=True)
    threading.Thread(target=watch_workspace, daemon=True).start()
    if not args.no_open:
        webbrowser.open(url)
    with contextlib.suppress(KeyboardInterrupt):
        server.serve_forever()


def board_running(url):
    with contextlib.suppress(OSError, ValueError):
        with urllib.request.urlopen(url + "/api/board", timeout=2) as res:
            json.load(res)
        return True
    return False


def cmd_open(args):
    url = "http://127.0.0.1:%d" % args.port
    if not board_running(url):
        proc = subprocess.Popen(
            [sys.executable, os.path.realpath(__file__), "serve", "--no-open", "--port", str(args.port)],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True,
        )
        deadline = time.time() + 10
        while not board_running(url):
            if proc.poll() is not None or time.time() > deadline:
                raise KbError("Couldn't start the board on port %d. Run kb serve to see why." % args.port)
            time.sleep(0.2)
        print("Started Bento in the background (pid %d). kb service install keeps it running at login." % proc.pid)
    webbrowser.open(url)
    print("Opened %s" % url)


def build_parser():
    who = argparse.ArgumentParser(add_help=False)
    who.add_argument("--as", dest="who", default=os.environ.get("KB_AS"), help="your name")
    where = argparse.ArgumentParser(add_help=False)
    where.add_argument("--project", "-p", help="project (default: the connected folder you're in)")
    where.add_argument("--all-projects", action="store_true", help="ignore the folder you're in")

    parser = argparse.ArgumentParser(prog="kb", description="Bento: a kanban board and product docs in plain Markdown.")
    parser.add_argument("--all", action="store_true", help="show all of Done")
    parser.add_argument("--json", action="store_true", help="output JSON")
    parser.add_argument("--project", "-p", help="show one project")
    parser.add_argument("--kind", help="show one kind: implementation, testing, release or writing")
    parser.set_defaults(func=cmd_list)
    sub = parser.add_subparsers(title="commands", metavar="")

    p = sub.add_parser("list", help="show the board, across projects")
    p.add_argument("--all", action="store_true", help="show all of Done")
    p.add_argument("--json", action="store_true", help="output JSON")
    p.add_argument("--project", "-p", help="show one project")
    p.add_argument("--kind", help="show one kind: implementation, testing, release or writing")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("next", parents=[who, where], help="best card for you; changes nothing")
    p.add_argument("--json", action="store_true", help="output JSON")
    p.set_defaults(func=cmd_next)

    p = sub.add_parser("inbox", help="what's waiting on the owner, in your chosen order")
    p.add_argument("--project", "-p", help="show one project")
    p.add_argument("--order", help="set the sections and their order, such as blocked,review,plans")
    p.add_argument("--reset", action="store_true", help="go back to the default order")
    p.add_argument("--json", action="store_true", help="output JSON")
    p.set_defaults(func=cmd_inbox)

    p = sub.add_parser("show", help="one card in full")
    p.add_argument("id", type=int)
    p.add_argument("--json", action="store_true", help="output JSON")
    p.set_defaults(func=cmd_show)

    p = sub.add_parser("claim", parents=[who, where], help="take cards from Next")
    p.add_argument("ids", type=int, nargs="*")
    p.add_argument("--also", action="store_true", help="take more while holding a card")
    p.set_defaults(func=cmd_claim)

    p = sub.add_parser("add", parents=[who], help="add an epic (to Backlog by default)")
    p.add_argument("title")
    p.add_argument("--for", dest="for_who", help="any (default), or a name")
    p.add_argument("--project", "-p", help="project (default: the connected folder you're in)")
    p.add_argument("--kind", help="implementation, testing, release, writing or milestone")
    p.add_argument("--release", help="release this belongs to")
    p.add_argument("--target", help="date for a milestone or release, such as 2026-12-01")
    p.add_argument("--theme", help="the theme of a milestone or release")
    p.add_argument("--source", help="doc it was pulled from, with an optional #heading")
    p.add_argument("--plan", help="plan doc")
    p.add_argument("--needs", help="card numbers this depends on, such as 3,4")
    p.add_argument("--verifies", help="card numbers a testing epic checks")
    p.add_argument("--done-when")
    p.add_argument("--note")
    p.add_argument("--to", help="column (default: Backlog; Milestones for milestones)")
    p.add_argument("--top", action="store_true", help="put it at the top of the column")
    p.set_defaults(func=cmd_add)

    p = sub.add_parser("plan", help="start a plan or milestone doc")
    p.add_argument("kind", help="implementation, testing, release, writing or milestone")
    p.add_argument("title")
    p.add_argument("--project", "-p", help="project (default: the connected folder you're in)")
    p.add_argument("--epics", type=int, nargs="*", default=[], help="card numbers this plan covers")
    p.set_defaults(func=cmd_plan)

    p = sub.add_parser("push", aliases=["handoff"], parents=[who], help="hand epics, and optionally a plan, to someone")
    p.add_argument("ids", type=int, nargs="+")
    p.add_argument("--to", required=True, help="who takes it")
    p.add_argument("--plan", help="plan doc")
    p.add_argument("--wait", action="store_true", help="stay running until the work finishes or gets stuck")
    p.set_defaults(func=cmd_handoff)

    p = sub.add_parser("wait", help="sleep until epics reach Review, or one gets stuck; nothing polls")
    p.add_argument("ids", type=int, nargs="+")
    p.add_argument("--until", choices=["review", "done"], default="review")
    p.add_argument("--timeout", type=float, help="give up after this many seconds")
    p.set_defaults(func=cmd_wait)

    p = sub.add_parser("wake", help="have this agent session hear when epics finish")
    p.add_argument("ids", type=int, nargs="+")
    p.set_defaults(func=cmd_wake)

    p = sub.add_parser("service", help="run Bento in the background so sessions always hear back")
    p.add_argument("action", choices=["install", "uninstall", "status"])
    p.add_argument("--port", type=int, default=4747)
    p.set_defaults(func=cmd_service)

    p = sub.add_parser("move", parents=[who], help="move a card to a column")
    p.add_argument("id", type=int)
    p.add_argument("column")
    p.add_argument("--top", action="store_true", help="put it at the top of the column")
    p.set_defaults(func=cmd_move)

    p = sub.add_parser("review", parents=[who], help="hand finished work to the owner")
    p.add_argument("id", type=int)
    p.add_argument("--note")
    p.set_defaults(func=cmd_review)

    p = sub.add_parser("delete", help="delete a card; it goes to TRASH.md")
    p.add_argument("id", type=int)
    p.set_defaults(func=cmd_delete)

    p = sub.add_parser("restore", help="bring back a deleted card")
    p.add_argument("id", type=int)
    p.set_defaults(func=cmd_restore)

    p = sub.add_parser("note", parents=[who], help="add a dated note")
    p.add_argument("id", type=int)
    p.add_argument("text")
    p.set_defaults(func=cmd_note)

    p = sub.add_parser("set", parents=[who], help="change or clear a card field")
    p.add_argument("id", type=int)
    p.add_argument("field", help="such as needs, release, plan or 'done when'")
    p.add_argument("value", nargs="*", help="leave empty to clear it")
    p.set_defaults(func=cmd_set)

    p = sub.add_parser("block", help="flag a card as stuck")
    p.add_argument("id", type=int)
    p.add_argument("reason")
    p.set_defaults(func=cmd_block)

    p = sub.add_parser("unblock", help="clear a block")
    p.add_argument("id", type=int)
    p.set_defaults(func=cmd_unblock)

    p = sub.add_parser("archive", help="move Done cards to ARCHIVE.md")
    p.set_defaults(func=cmd_archive)

    p = sub.add_parser("init", help="create a workspace for your board and docs")
    p.add_argument("path", nargs="?", help="where it lives (default: ~/.bento)")
    p.add_argument("--owner", help="your name on the board")
    p.set_defaults(func=cmd_init)

    p = sub.add_parser("connect", help="connect a project folder to Bento")
    p.add_argument("path", nargs="?", help="folder (default: this one)")
    p.add_argument("--name", help="project name (default: the folder's name)")
    p.add_argument("--import-docs", action="store_true", help="also copy its docs into the workspace")
    p.set_defaults(func=cmd_connect)

    p = sub.add_parser("import", help="refresh docs from connected projects")
    p.add_argument("project", nargs="?")
    p.set_defaults(func=cmd_import)

    p = sub.add_parser("projects", help="list connected projects")
    p.set_defaults(func=cmd_projects)

    p = sub.add_parser("docs", parents=[where], help="list product docs and plans")
    p.add_argument("--long", action="store_true", help="list every doc")
    p.add_argument("--json", action="store_true", help="output JSON")
    p.set_defaults(func=cmd_docs)

    p = sub.add_parser("calendar", help="what is meant to ship when, and how its dependencies stand")
    p.add_argument("--project", "-p", help="show one project")
    p.add_argument("--json", action="store_true", help="output JSON")
    p.set_defaults(func=cmd_calendar)

    p = sub.add_parser("report", help="track daily reports and where they arrive")
    p.add_argument("action", choices=["list", "add", "post", "show", "rm"])
    p.add_argument("name", nargs="?")
    p.add_argument("file", nargs="?", help="for post: a Markdown file (default: stdin)")
    p.add_argument("--thread", help="Codex thread id it arrives in")
    p.add_argument("--link", help="any other address it arrives at")
    p.add_argument("--project", "-p", help="project (default: the connected folder you're in)")
    p.add_argument("--schedule", help="such as 'Daily at 2:00'")
    p.add_argument("--json", action="store_true", help="output JSON")
    p.set_defaults(func=cmd_report)

    p = sub.add_parser("history", help="list local snapshots of the workspace")
    p.add_argument("path", nargs="?", help="only snapshots that changed this file")
    p.add_argument("--limit", type=int, default=20)
    p.set_defaults(func=cmd_history)

    p = sub.add_parser("rules", help="print how people and agents use the board")
    p.set_defaults(func=cmd_rules)

    p = sub.add_parser("install-agents", help="tell Claude Code and Codex about Bento")
    p.set_defaults(func=cmd_install_agents)

    p = sub.add_parser("uninstall-agents", help="undo install-agents; your workspace stays")
    p.set_defaults(func=cmd_uninstall_agents)

    p = sub.add_parser("serve", help="open the web board")
    p.add_argument("--port", type=int, default=4747)
    p.add_argument("--no-open", action="store_true", help="don't open a browser")
    p.set_defaults(func=cmd_serve)

    p = sub.add_parser("open", help="open the web board, starting it if needed")
    p.add_argument("--port", type=int, default=4747)
    p.set_defaults(func=cmd_open)
    return parser


def main():
    args = build_parser().parse_args()
    CTX.actor = (getattr(args, "who", None) or "").lower() or None
    try:
        args.func(args)
    except KbError as e:
        print("kb: %s" % e, file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
