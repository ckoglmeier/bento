def require_who(args):
    if not args.who:
        raise KbError("Say who you are: --as claude, --as codex or --as %s (or set KB_AS)." % owner())
    return args.who.lower()


def summary(card):
    bits = []
    f = card.fields()
    if f.get("project"):
        bits.append("[%s]" % f["project"])
    if f.get("kind") and f["kind"] != "implementation":
        bits.append(f["kind"])
    if f.get("for") and f["for"] != "any":
        bits.append("for:" + f["for"])
    if f.get("claimed"):
        bits.append("claimed:" + f["claimed"])
    if f.get("target"):
        bits.append("target:" + f["target"])
    if f.get("needs"):
        bits.append("needs:" + f["needs"])
    if f.get("verifies"):
        bits.append("verifies:" + f["verifies"])
    if f.get("plan"):
        bits.append("plan")
    if f.get("blocked"):
        bits.append("BLOCKED: " + f["blocked"])
    return "#%d %s%s" % (card.id, card.title, "  " + " ".join(bits) if bits else "")


def scope(args):
    """The project a command is limited to: --project, else the connected folder, unless --all-projects."""
    if getattr(args, "all_projects", False):
        return None
    return getattr(args, "project", None) or detect_project()


def cmd_list(args):
    board = load()
    if args.json:
        print(json.dumps(board_json(board), indent=2))
        return
    project = getattr(args, "project", None)
    kind = getattr(args, "kind", None)
    for section in board.sections:
        cards = [
            c for c in section.cards
            if (not project or c.get("project") == project)
            and (not kind or (c.get("kind") or "implementation") == kind)
        ]
        print("%s (%d)" % (section.name.upper(), len(cards)))
        shown = cards if args.all or section.name.lower() != "done" else cards[:5]
        for card in shown:
            print("  " + summary(card))
        if len(shown) < len(cards):
            print("  ... %d more (--all)" % (len(cards) - len(shown)))
        print()


