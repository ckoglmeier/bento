def cmd_claim(args):
    who = require_who(args)
    texts = []
    with locked() as board:
        held = held_by(board, who)
        if held and not args.also:
            raise KbError(
                "%s already holds #%d. Finish it first, or pass --also to work in parallel." % (who, held[0].id)
            )
        if args.ids:
            cards = []
            for id in args.ids:
                section, card = board.find(id)
                if section.name.lower() != "next":
                    raise KbError("#%d is in %s, not Next, so it can't be claimed." % (card.id, section.name))
                reason = why_not_ready(board, card, who)
                if reason:
                    raise KbError("#%d can't be claimed: %s." % (card.id, reason))
                cards.append(card)
        else:
            card = pick(board, who, scope(args))
            if not card:
                raise KbError("Nothing in Next can be picked up by %s. Run: kb next --as %s" % (who, who))
            cards = [card]
        for card in cards:
            card.set("claimed", "%s %s" % (who, today()))
            move_card(board, card, "Doing")
            texts.append(card.markdown())
    print("Claimed by %s:\n\n%s" % (who, "\n\n".join(texts)))


