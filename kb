def require_who(args):
    if not args.who:
        raise KbError("Say who you are: --as claude, --as codex or --as %s (or set KB_AS)." % owner())
    return args.who.lower()


def summary(card):
    bits = []
    f = card.fields()
    if f.get("project"):
        bits.append("[%s]" % f["project"])
    if f.get("kind") and f["kind"] != "implementation":
        bits.append(f["kind"])
    if f.get("for") and f["for"] != "any":
        bits.append("for:" + f["for"])
    if f.get("claimed"):
        bits.append("claimed:" + f["claimed"])
    if f.get("target"):
        bits.append("target:" + f["target"])
    if f.get("needs"):
        bits.append("needs:" + f["needs"])
    if f.get("verifies"):
        bits.append("verifies:" + f["verifies"])
    if f.get("plan"):
        bits.append("plan")
    if f.get("blocked"):
        bits.append("BLOCKED: " + f["blocked"])
    return "#%d %s%s" % (card.id, card.title, "  " + " ".join(bits) if bits else "")


def scope(args):
    """The project a command is limited to: --project, else the connected folder, unless --all-projects."""
    if getattr(args, "all_projects", False):
        return None
    return getattr(args, "project", None) or detect_project()


def cmd_list(args):
    board = load()
    if args.json:
        print(json.dumps(board_json(board), indent=2))
        return
    project = getattr(args, "project", None)
    kind = getattr(args, "kind", None)
    for section in board.sections:
        cards = [
            c for c in section.cards
            if (not project or c.get("project") == project)
            and (not kind or (c.get("kind") or "implementation") == kind)
        ]
        print("%s (%d)" % (section.name.upper(), len(cards)))
        shown = cards if args.all or section.name.lower() != "done" else cards[:5]
        for card in shown:
            print("  " + summary(card))
        if len(shown) < len(cards):
            print("  ... %d more (--all)" % (len(cards) - len(shown)))
        print()


def cmd_inbox(args):
    config = read_config()
    if args.reset or args.order is not None:
        config["inbox"] = list(DEFAULT_INBOX) if args.reset else parse_inbox_order(re.split(r"[,\s]+", args.order))
        if not config["inbox"]:
            raise KbError("Name at least one section: %s." % ", ".join(INBOX_SECTIONS))
        write_config(config)
        print("Inbox order: %s" % ", ".join(config["inbox"]))
        return
    items = inbox(load(), config, args.project)
    if args.json:
        print(json.dumps({"order": inbox_order(config), "items": items}, indent=2))
        return
    who = config.get("owner", "me")
    if not items:
        print("Nothing is waiting on %s." % who)
        return
    print("%d waiting on %s\n" % (len(items), who))
    for key in inbox_order(config):
        group = [i for i in items if i["section"] == key]
        if not group:
            continue
        print("%s (%d)" % (INBOX_SECTIONS[key], len(group)))
        for item in group:
            ids = ", ".join("#%d" % n for n in item["ids"])
            line = "  %s %s" % (ids, item["title"])
            if item["project"]:
                line += "  [%s]" % item["project"]
            if item["why"]:
                line += "  %s" % item["why"]
            print(line)
        print()


