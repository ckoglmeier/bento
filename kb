def api_review(data):
    """Approve a plan or ask for changes, on every epic that shares it."""
    plan, decision, comment = data["plan"], data["decision"], one_line(data.get("comment", ""))
    if decision == "changes" and not comment:
        raise KbError("Say what should change.")
    if decision not in ("approve", "changes"):
        raise KbError("Unknown decision.")
    me = owner()
    with locked() as board:
        cards = [c for _, c in board.all_cards() if c.get("plan") == plan]
        if not cards:
            raise KbError("No epic uses this plan.")
        for card in cards:
            if decision == "approve":
                card.set("approved", "%s %s" % (me, today()))
                if (card.get("blocked") or "").startswith("changes requested"):
                    card.set("blocked", None)
                card.note("approved the plan" + (": " + comment if comment else ""), me)
            else:
                card.set("approved", None)
                card.set("blocked", "changes requested: " + comment)
                card.note("asked for changes: " + comment, me)


