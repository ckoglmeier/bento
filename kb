def resume(board, who, project=None):
    """Where an agent stands at the start of a session, and what to do next."""
    me = owner().lower()
    mine = [(s, c) for s, c in board.all_cards()
            if (not project or c.get("project") == project)
            and ((s.name.lower() == "doing" and (c.get("claimed") or "").split(" ")[0].lower() == who)
                 or (s.name.lower() == "next" and (c.get("for") or "").lower() == who))]
    out = []
    held = [c for s, c in mine if s.name.lower() == "doing"]
    if held:
        out.append("You hold:")
        for c in held:
            out.append("  #%d %s (claimed %s)%s" % (c.id, c.title, (c.get("claimed") or "").split(" ")[-1], "  BLOCKED: " + c.get("blocked") if c.get("blocked") else ""))
            if c.get("done when"):
                out.append("    Done when: %s" % c.get("done when"))
            if c.get("plan"):
                out.append("    Plan: %s" % c.get("plan"))
    back = []
    for s, c in mine:
        notes = card_notes(c)
        yours = [i for i, n in enumerate(notes) if (n[1] or "").lower() == who]
        since = [n for n in notes[(yours[-1] + 1 if yours else 0):] if (n[1] or "").lower() == me]
        if since:
            back.append("  #%d %s:" % (c.id, c.title))
            back.extend("    %s %s: %s" % (n[0], n[1], n[2]) for n in since[-3:])
        elif (c.get("blocked") or "").startswith("changes requested"):
            back.append("  #%d %s: %s" % (c.id, c.title, c.get("blocked")))
    if back:
        out.append("Came back to you:")
        out.extend(back)
    ids = {c.id for _, c in mine}
    decided = [d for d in reversed(read_decisions()) if set(decision_cards(d)) & ids and not d["fields"].get("superseded by")]
    if decided:
        out.append("Decisions on your epics:")
        out.extend("  %s %s: %s" % (d["id"], d["fields"].get("date", ""), d["text"]) for d in decided[:6])
    waiting = [c for s, c in mine if s.name.lower() == "next"]
    if waiting:
        out.append("Handed to you in Next: %s" % ", ".join("#%d %s" % (c.id, c.title) for c in waiting))
    working = [c for c in held if not c.get("blocked")]
    if back:
        step = "Read what came back on #%d and carry on." % int(re.search(r"#(\d+)", back[0]).group(1))
    elif working:
        step = "Carry on with #%d %s." % (working[0].id, working[0].title)
    elif waiting:
        step = "Claim it: kb claim %d --as %s" % (waiting[0].id, who)
    else:
        card = pick(board, who, project)
        step = ("Ask %s before claiming #%d %s (kb next --as %s)." % (owner(), card.id, card.title, who)) if card else "Nothing to pick up. Tell %s." % owner()
        if held:
            step = "Everything you hold is blocked on %s. %s" % (owner(), step)
    out.append("Next step: " + step)
    return "\n".join(out)


