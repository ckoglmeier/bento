def cmd_report(args):
    config = read_config()
    reports = config.setdefault("reports", {})
    if args.action == "list":
        data = reports_json()
        if args.json:
            print(json.dumps(data, indent=2))
            return
        for item in data:
            latest = item["latest"]["date"] if item["latest"] else "no copy posted yet"
            print("%s  [%s]  %s  %s  latest: %s" % (item["key"], item.get("project") or "-", item.get("schedule") or "-", item["url"] or "-", latest))
        return
    if not args.name:
        raise KbError("Which report? Run: kb report list")
    key = report_key(args.name)
    if args.action == "add":
        if not (args.thread or args.link):
            raise KbError("Say where it arrives: --thread <Codex thread id> or --link <url>.")
        if args.link and not re.match(r"(?i)^(https?|codex|claude)://", args.link):
            raise KbError("--link must be an http, https, codex or claude address.")
        info = {"name": one_line(args.name), "project": args.project or detect_project()}
        for field, value in (("thread", args.thread), ("link", args.link), ("schedule", args.schedule)):
            if value:
                info[field] = value
        reports[key] = info
        write_config(config)
        print("Tracking %s." % info["name"])
        return
    if key not in reports:
        raise KbError("No report called '%s'. Run: kb report list" % args.name)
    info = reports[key]
    if args.action == "rm":
        del reports[key]
        write_config(config)
        print("Stopped tracking %s. Copies already posted were kept." % info["name"])
    elif args.action == "post":
        if args.file and args.file != "-":
            with open(os.path.expanduser(args.file), encoding="utf-8") as f:
                text = f.read()
        else:
            text = sys.stdin.read()
        if not text.strip():
            raise KbError("That report is empty.")
        folder = os.path.join(home_dir(), "products", info.get("project") or "_general", "reports", key)
        os.makedirs(folder, exist_ok=True)
        atomic_write(os.path.join(folder, today() + ".md"), text.rstrip("\n") + "\n")
        print("Posted %s for %s." % (info["name"], today()))
    else:
        latest = report_latest(key, info)
        if not latest:
            raise KbError("No copy of %s has been posted yet. It arrives at %s" % (info["name"], report_url(info)))
        with open(os.path.join(home_dir(), latest["path"]), encoding="utf-8") as f:
            print("[%s]\n%s" % (latest["date"], f.read()))


