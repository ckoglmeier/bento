HERE = os.path.dirname(os.path.realpath(__file__))
POINTER = os.path.expanduser("~/.config/bento/home")
DEFAULT_HOME = os.path.expanduser("~/.bento")
COLUMNS = ["Scratchpad", "Milestones", "Backlog", "Next", "Doing", "Review", "Done"]
KINDS = ["implementation", "testing", "release", "writing"]
DATED_KINDS = ["milestone", "release"]  # Only these go on the calendar.
