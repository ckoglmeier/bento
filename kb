def clean_body(text):
    """Make free text safe to store in a card, so it can't start a new card or column."""
    lines = text.replace("\r\n", "\n").split("\n")
    if sum(1 for l in lines if l.lstrip().startswith("```")) % 2:
        raise KbError("That text has an unclosed ``` code fence.")
    out, fenced = [], False
    for line in lines:
        if line.lstrip().startswith("```"):
            fenced = not fenced
        out.append("\\" + line if not fenced and re.match(r"^#{2,3} ", line) else line)
    return trim(out)


