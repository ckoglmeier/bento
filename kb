    p.set_defaults(func=cmd_calendar)

    p = sub.add_parser("report", help="track daily reports and where they arrive")
    p.add_argument("action", choices=["list", "add", "post", "show", "rm"])
    p.add_argument("name", nargs="?")
    p.add_argument("file", nargs="?", help="for post: a Markdown file (default: stdin)")
    p.add_argument("--thread", help="Codex thread id it arrives in")
    p.add_argument("--link", help="any other address it arrives at")
    p.add_argument("--project", "-p", help="project (default: the connected folder you're in)")
    p.add_argument("--schedule", help="such as 'Daily at 2:00'")
    p.add_argument("--json", action="store_true", help="output JSON")
    p.set_defaults(func=cmd_report)

    p = sub.add_parser("history", help="list local snapshots of the workspace")
    p.add_argument("path", nargs="?", help="only snapshots that changed this file")
    p.add_argument("--limit", type=int, default=20)
    p.set_defaults(func=cmd_history)

    p = sub.add_parser("rules", help="print how people and agents use the board")
    p.set_defaults(func=cmd_rules)

    p = sub.add_parser("install-agents", help="tell Claude Code and Codex about Bento")
    p.set_defaults(func=cmd_install_agents)

    p = sub.add_parser("uninstall-agents", help="undo install-agents; your workspace stays")
    p.set_defaults(func=cmd_uninstall_agents)

    p = sub.add_parser("serve", help="open the web board")
    p.add_argument("--port", type=int, default=4747)
    p.add_argument("--no-open", action="store_true", help="don't open a browser")
    p.set_defaults(func=cmd_serve)

    p = sub.add_parser("open", help="open the web board, starting it if needed")
    p.add_argument("--port", type=int, default=4747)
    p.set_defaults(func=cmd_open)
    return parser


def main():
    args = build_parser().parse_args()
    CTX.actor = (getattr(args, "who", None) or "").lower() or None
    try:
        args.func(args)
    except KbError as e:
        print("kb: %s" % e, file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
