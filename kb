        pairs = [board.find(i) for i in args.ids]
        for section, card in pairs:
            if section.name.lower() == "done":
                raise KbError("#%d is already Done." % card.id)
            if section.name.lower() == "doing" and not (card.get("claimed") or "").startswith(who):
                raise KbError("#%d is being worked on by %s." % (card.id, card.get("claimed")))
        for _, card in reversed(pairs):
            card.set("for", target)
            if plan:
                card.set("plan", plan)
                card.set("approved", None)
            card.note("handed to %s" % target, who)
            move_card(board, card, "Next", top=True)
    print("Handed %s to %s.%s" % (
        ", ".join("#%d" % i for i in args.ids), target,
        " Plan: %s" % os.path.join(home_dir(), plan) if plan else "",
