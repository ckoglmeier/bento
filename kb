def today():
    return datetime.date.today().isoformat()


def one_line(text):
    return " ".join(str(text).split())


def slug(text):
    """Heading anchor; board.html computes the same value."""
    return re.sub(r"\s", "-", re.sub(r"[^a-z0-9 _-]", "", re.sub(r"[*_`]", "", text).strip().lower()))


# ---- Workspace --------------------------------------------------------------


def home_dir():
    if os.environ.get("BENTO_HOME"):
        return os.path.realpath(os.path.expanduser(os.environ["BENTO_HOME"]))
    if os.path.exists(POINTER):
        with open(POINTER, encoding="utf-8") as f:
            return os.path.realpath(os.path.expanduser(f.read().strip()))
    return os.path.realpath(DEFAULT_HOME)


def board_path():
    return os.path.join(home_dir(), "BOARD.md")


def archive_path():
