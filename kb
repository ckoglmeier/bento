        "- When %s says \"open bento\", run `kb open`. It opens the board in the browser." % owner(),
        "- When %s says \"note for bento\", save the discussion as a Scratchpad note: `kb add \"<short title>\" --to scratchpad --as %s --note \"<a few sentences: what was decided, open questions, next steps>\"`. Use only what was said, and don't start any work from it." % (owner(), name),
        "- Before you change the board or write a plan, run `kb rules` and follow them.",
        "- Product docs live in `%s/products/`, not in the project repo. Run `kb docs` to find them." % home_dir(),
        BLOCK_END,
        "",
    ])


def write_block(path, block):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    text = ""
    if os.path.exists(path):
        with open(path, encoding="utf-8") as f:
            text = f.read()
    if BLOCK_START in text and BLOCK_END in text:
        head, rest = text.split(BLOCK_START, 1)
        text = head + block.rstrip("\n") + rest.split(BLOCK_END, 1)[1]
    else:
        text = (text.rstrip("\n") + "\n\n" if text.strip() else "") + block
    atomic_write(os.path.realpath(path), text)


