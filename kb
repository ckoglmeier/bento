PLAN_TEMPLATES = {
    "implementation": "## Goal\n\n## Epics\n\n{epics}\n\n## Approach\n\n## Out of scope\n\n## Risks and open questions\n\n## Done when\n",
    "testing": "## What this verifies\n\n{epics}\n\n## Environments\n\n## Checks\n\n| Check | How | Expected | Result |\n| --- | --- | --- | --- |\n\n## Failure and recovery cases\n\n## Results\n",
    "release": "## Theme\n\n## What ships\n\n{epics}\n\n## Acceptance criteria\n\n## Rollout steps\n\n## Rollback\n\n## Release notes\n\n## After release\n",
    "milestone": "## Theme\n\n## What's in it\n\n{epics}\n\n## Acceptance criteria\n\n## Release notes\n\n## After it lands\n",
    "writing": "## The piece\n\n{epics}\n\n## Audience\n\n## Outline\n\n## Channel and publish date\n\n## What it warms up\n",
}


def create_plan(kind, project, title, ids):
    """Start a plan doc for these cards and link it to them. Returns its workspace path."""
    if kind not in PLAN_TEMPLATES:
        raise KbError("Kind must be one of: %s." % ", ".join(sorted(PLAN_TEMPLATES)))
    folder = os.path.join(home_dir(), "products", project, "plans")
    os.makedirs(folder, exist_ok=True)
    full = os.path.join(folder, "%s-%s.md" % (kind, slug(title).strip("-") or "plan"))
    rel = os.path.relpath(full, home_dir())
    if os.path.exists(full):
        raise KbError("%s already exists." % rel)
    with locked() as board:
        cards = [board.find(i)[1] for i in ids]
        for card in cards:
            card.set("plan", rel)
        listed = cards
        if kind in DATED_KINDS and cards:
            # A milestone's doc lists the work feeding it, not the milestone itself.
            listed = []
            for dep in dependency_ids(board, cards[0]):
                with contextlib.suppress(KbError):
                    listed.append(board.find(dep)[1])
    epics = "\n".join("- #%d %s" % (c.id, c.title) for c in listed) or "- (none linked yet)"
    heading = one_line(title) if kind == "milestone" else "%s plan: %s" % (kind.capitalize(), one_line(title))
    atomic_write(full, "# %s\n\n%s" % (heading, PLAN_TEMPLATES[kind].format(epics=epics)))
    return rel


def cmd_plan(args):
    project = args.project or detect_project()
    if not project:
        raise KbError("Which project? Pass --project, or run this from a connected folder.")
    rel = create_plan(args.kind, project, args.title, args.epics)
    print("Created %s" % os.path.join(home_dir(), rel))


def card_state(board, id):
    """Column name for a card, treating an archived card as Done."""
    try:
        return board.find(id)[0].name.lower()
    except KbError:
        if os.path.exists(archive_path()):
            with open(archive_path(), encoding="utf-8") as f:
                if re.search(r"^### #%d\b" % id, f.read(), re.M):
                    return "done"
        raise


def wait_for(ids, until="review", timeout=None):
    """Sleep until every card finishes, or one gets stuck. Returns an exit code."""
    finished = ("done",) if until == "done" else ("review", "done")
    watch = Watch()
    deadline = time.time() + timeout if timeout else None
    while True:
        board = load()
        states = {i: card_state(board, i) for i in ids}
        stuck = [i for i in ids if states[i] != "done" and board.find(i)[1].get("blocked")]
        if stuck:
            for i in stuck:
                print("Blocked:\n\n%s\n" % board.find(i)[1].markdown())
            return 2
        if all(states[i] in finished for i in ids):
            for i in ids:
                with contextlib.suppress(KbError):
                    print("[%s]\n%s\n" % (states[i].capitalize(), board.find(i)[1].markdown()))
            print("Finished: %s" % ", ".join("#%d" % i for i in ids))
            return 0
        left = deadline - time.time() if deadline else 30
        if left <= 0:
            print("Still waiting: %s" % ", ".join("#%d" % i for i in ids if states[i] not in finished))
            return 3
        watch.wait(min(left, 30))


def cmd_wake(args):
    load()
    if not current_session():
        raise KbError("This isn't running inside an agent session.")
    hear_back_hint(args.ids)


def cmd_wait(args):
